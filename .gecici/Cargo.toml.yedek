[package]
name = "ollama_proje"
version = "0.1.0"
edition = "2021"

[dependencies]
chrono = "0.4"
eframe = "0.27"
image = { version = "0.25", default-features = false, features = ["png"] }
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"
ureq = "2"

# Windows .exe dosya ikonu ve sürüm bilgisi (build.rs).
[target.'cfg(windows)'.build-dependencies]
winresource = "0.1"